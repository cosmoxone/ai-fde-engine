# ============================================
# AI-FDE Engine 环境变量配置
# 复制为 .env 并修改对应值
# ============================================

# ===== 系统配置 =====
APP_NAME=AI-FDE Engine
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
# 生产环境务必修改以下密钥（至少16位）
SECRET_KEY=change-me-to-a-random-string-at-least-16-chars
JWT_SECRET=change-me-to-another-random-string-at-least-16
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=*
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== 管理员账号（首次启动自动创建）=====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@2026
ADMIN_NAME=Administrator

# ===== LLM 模型配置 =====
# 模型提供方: deepseek / qwen / openai / ollama / custom
LLM_PROVIDER=deepseek

# DeepSeek API（推荐用于代码和Agent任务）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CODE_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# Qwen API（推荐用于中文调研和管理任务）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_RESEARCH_MODEL=qwen3.6-27b
QWEN_LONG_CONTEXT_MODEL=qwen3.5-397b

# 本地模型（私有化部署时使用）
LOCAL_MODEL_BASE_URL=http://vllm:8000/v1
LOCAL_MODEL_API_KEY=not-needed
LOCAL_MODEL_NAME=qwen3.6-27b

# 模型路由（按任务类型自动选择最优模型）
MODEL_ROUTING_ENABLED=true
MODEL_TASK_CODE=deepseek-v4-pro
MODEL_TASK_RESEARCH=qwen3.6-27b
MODEL_TASK_DESIGN=deepseek-v4-pro
MODEL_TASK_EVALUATION=deepseek-v4-flash
MODEL_TASK_PROJECT=qwen3.6-27b

# ===== 数据库 =====
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=aifde
POSTGRES_USER=aifde
POSTGRES_PASSWORD=aifde_secure_password_change_me
POSTGRES_POOL_SIZE=20

# ===== 向量数据库 =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aifde_

# ===== 对象存储 =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aifde_minio
MINIO_SECRET_KEY=aifde_minio_secure_key_change_me
MINIO_BUCKET=aifde-documents
MINIO_SECURE=false

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# ===== 记忆系统 =====
# 记忆提供方: zep / mem0 / letta / hybrid / mock
# 生产环境默认使用mem0（智能记忆层，实体抽取+语义检索）
# 未安装mem0ai时自动降级到hybrid（时序知识图谱+JSON持久化）
MEMORY_PROVIDER=mem0
MEMORY_GRAPH_ENABLED=true
MEMORY_TEMPORAL_ENABLED=true
MEMORY_CONSOLIDATION_CRON=0 3 * * *
MEMORY_CROSS_PROJECT_SEARCH=true

# Mem0配置（可选，使用默认配置时留空）
MEM0_API_KEY=
MEM0_API_URL=

# Letta配置（可选，使用letta provider时需要）
LETTA_API_URL=
LETTA_API_KEY=

# ===== 文档解析 =====
# 解析提供方: marker / docling / hybrid / mock
# 生产环境默认使用docling（多格式解析，CPU可用，76.0分）
# 有GPU时可切换为marker（7.4页/秒，总分76.0超Docling）
# 未安装docling时自动降级到mock
DOC_PARSER_PROVIDER=docling
DOC_PARSER_MARKER_GPU=false
DOC_PARSER_BATCH_SIZE=5
DOC_PARSER_TIMEOUT=300
DOC_PARSER_LANGUAGE=chinese

# ===== 知识库 =====
# 知识库提供方: lightrag / graphrag / qdrant / basic / mock
# 生产环境默认使用qdrant（向量数据库+本地bge-m3 Embedding）
# docker-compose自动启动qdrant服务，无需额外配置
# 未安装qdrant-client/sentence-transformers时自动降级到mock
KB_PROVIDER=qdrant
KB_EMBEDDING_MODEL=bge-m3
KB_EMBEDDING_DIM=1024
KB_CHUNK_SIZE=1024
KB_CHUNK_OVERLAP=128
KB_GRAPH_EXTRACTION_ENABLED=true
KB_INCREMENTAL_UPDATE=true

# ===== Benchmark =====
BENCHMARK_DEFAULT_CASE_COUNT=50
BENCHMARK_CATEGORY_RATIO=high_frequency:0.6,edge:0.3,adversarial:0.1
BENCHMARK_AUTO_GENERATION=true
BENCHMARK_ADVERSARIAL_ENABLED=true

# ===== 评测 =====
# 评测提供方: deepeval / mock
# 生产环境默认使用deepeval（50+ LLM评测指标，pytest原生）
# 未安装deepeval时自动降级到mock
EVALUATION_PROVIDER=deepeval
EVALUATION_GATE_ENABLED=true
EVALUATION_GATE_ACCURACY=0.8
EVALUATION_GATE_HALLUCINATION=0.1
EVALUATION_GATE_RECALL=0.85
EVALUATION_AUTO_RUN_ON_VERSION=true

# ===== 代码生成 =====
# 代码生成提供方: openhands / aider / opencode / mock
# 生产环境默认使用aider（终端原生AI编程助手，git工作流）
# Docker镜像已安装git和aider-chat，开箱即用
# 未安装aider-chat时自动降级到mock
CODE_GEN_PROVIDER=aider
CODE_GEN_SANDBOX_ENABLED=true
CODE_GEN_TIMEOUT=3600
CODE_GEN_MAX_RETRIES=3
CODE_GEN_AUTO_TEST=true
CODE_GEN_AUTO_LINT=true
OPENHANDS_SANDBOX_TYPE=docker
OPENHANDS_WORKSPACE_BASE=/tmp/openhands-workspaces

# ===== 夜间迭代 =====
ITERATION_ENABLED=true
ITERATION_CRON=0 20 * * *
ITERATION_MAX_BADCASES=20
ITERATION_AUTO_DEPLOY=true
ITERATION_AUTO_ROLLBACK=true
ITERATION_NOTIFICATION_WEBHOOK=

# ===== 可观测性 =====
# 可观测性提供方: langfuse / none
OBSERVABILITY_PROVIDER=none
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_ENABLED=true
TRACE_SAMPLE_RATE=1.0

# ===== 安全 =====
SECURITY_SENSITIVE_FILTER=true
SECURITY_PROMPT_INJECTION_PROTECTION=true
SECURITY_OUTPUT_AUDIT=true
SECURITY_DATA_ENCRYPTION=true
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_PER_MINUTE=60
